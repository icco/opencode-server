{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "github-copilot/gpt-6-astra",
  "default_agent": "orch-lead",
  "instructions": [
    "instructions.md"
  ],
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agents": {
    "title": {
      "model": "github-copilot/gpt-5.4-mini"
    },
    "compaction": {
      "model": "github-copilot/gpt-6-astra"
    },
    "orch-lead": {
      "mode": "primary",
      "permissions": [
        {
          "action": "grafana_*",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "orch-repo": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-docs": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-tests": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-research": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-critic": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-security": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-visual-reference": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-visual-generate": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-visual-review": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-editor": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-integrator": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-merge": {
      "mode": "subagent",
      "hidden": true
    },
    "orch-judge": {
      "mode": "subagent",
      "hidden": true
    }
  },
  "mcp": {
    "servers": {
      "lunchmoney": {
        "type": "local",
        "command": [
          "npx -y @akutishevsky/lunchmoney-mcp"
        ],
        "environment": {
          "LUNCHMONEY_API_TOKEN": "{env:LUNCHMONEY_API_TOKEN}"
        }
      },
      "grafana": {
        "type": "local",
        "command": [
          "mcp-grafana",
          "--transport",
          "stdio",
          "--enabled-tools",
          "search,datasource,prometheus,loki,alerting,dashboard,navigation,annotations",
          "--disable-write"
        ],
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "plugins": [
    "opencode-gemini-auth@2.0.1",
    "opencode-wakatime@1.4.0",
    "@oeronteros-1/opencode-orchestra@3.0.4",
    "@cardinal4/opencode-quota@5.1.0"
  ],
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "google",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "github-copilot",
        "effect": "allow"
      }
    ]
  },
  "share": "disabled",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
