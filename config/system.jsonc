{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "claude-agent/opus",
  "default_agent": "build",
  "providers": {
    "anthropic": {
      "models": {
        "auto": {
          "name": "Auto (Jev)",
          "capabilities": { "tools": true },
          "limit": { "context": 1000000, "output": 128000 }
        }
      }
    },
    "openai": {
      "models": {
        "fast-agent": {
          "name": "Fast Agent",
          "capabilities": { "tools": true },
          "limit": { "context": 1048576, "output": 8192 }
        }
      }
    },
    "recurse": {
      "name": "Recurse LLM",
      "env": ["RECURSE_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "https://llm.rcdis.co/v1" },
      "models": {
        "default": {
          "name": "Recurse LLM",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "medium", "high"] }
          },
          "settings": { "reasoningEffort": "high" },
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    }
  },
  "shell": "/usr/bin/zsh",
  "worktree": {
    "directory": "/data/workspace/.worktrees"
  },
  "compaction": {
    "buffer": 10000
  },
  "warming": true,
  "agents": {
    "build": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "bigquery_*", "resource": "*", "effect": "deny" },
        { "action": "pubsub_*", "resource": "*", "effect": "deny" },
        { "action": "cloudbilling_*", "resource": "*", "effect": "deny" },
        { "action": "iam_*", "resource": "*", "effect": "deny" },
        { "action": "bigquery_list_*", "resource": "*", "effect": "allow" },
        { "action": "bigquery_get_*", "resource": "*", "effect": "allow" },
        { "action": "bigquery_execute_sql_readonly", "resource": "*", "effect": "allow" },
        { "action": "pubsub_list_*", "resource": "*", "effect": "allow" },
        { "action": "pubsub_get_*", "resource": "*", "effect": "allow" },
        { "action": "cloudbilling_list_*", "resource": "*", "effect": "allow" },
        { "action": "cloudbilling_get_*", "resource": "*", "effect": "allow" },
        { "action": "cloudbilling_test_*", "resource": "*", "effect": "allow" },
        { "action": "iam_list_*", "resource": "*", "effect": "allow" },
        { "action": "iam_get_*", "resource": "*", "effect": "allow" },
        { "action": "iam_search_*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm *.config*", "effect": "ask" },
        { "action": "shell", "resource": "rm *.local*", "effect": "ask" },
        { "action": "shell", "resource": "rm *HOME*", "effect": "ask" },
        { "action": "shell", "resource": "rm *~*", "effect": "ask" },
        { "action": "shell", "resource": "rm */data", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/.*", "effect": "ask" }
      ]
    },
    "general": {
      "model": "openai/fast-agent",
      "permissions": [
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "gmail_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "robinhood_*", "resource": "*", "effect": "deny" },
        { "action": "bigquery_*", "resource": "*", "effect": "deny" },
        { "action": "cloudstorage_*", "resource": "*", "effect": "deny" },
        { "action": "pubsub_*", "resource": "*", "effect": "deny" },
        { "action": "cloudbilling_*", "resource": "*", "effect": "deny" },
        { "action": "iam_*", "resource": "*", "effect": "deny" },
        { "action": "cloudmonitoring_*", "resource": "*", "effect": "deny" },
        { "action": "maps_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "devknowledge_*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm *.config*", "effect": "ask" },
        { "action": "shell", "resource": "rm *.local*", "effect": "ask" },
        { "action": "shell", "resource": "rm *HOME*", "effect": "ask" },
        { "action": "shell", "resource": "rm *~*", "effect": "ask" },
        { "action": "shell", "resource": "rm */data", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/.*", "effect": "ask" }
      ]
    },
    "explore": {
      "model": "openai/fast-agent",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "gmail_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "robinhood_*", "resource": "*", "effect": "deny" },
        { "action": "bigquery_*", "resource": "*", "effect": "deny" },
        { "action": "cloudstorage_*", "resource": "*", "effect": "deny" },
        { "action": "pubsub_*", "resource": "*", "effect": "deny" },
        { "action": "cloudbilling_*", "resource": "*", "effect": "deny" },
        { "action": "iam_*", "resource": "*", "effect": "deny" },
        { "action": "cloudmonitoring_*", "resource": "*", "effect": "deny" },
        { "action": "maps_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "devknowledge_*", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "openai/fast-agent"
    },
    "compaction": {
      "model": "openai/fast-agent"
    }
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "gmail": {
        "type": "remote",
        "url": "https://gmailmcp.googleapis.com/mcp/v1",
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose"
        }
      },
      "foods": {
        "type": "remote",
        "url": "https://foods.timeclimbers.com/mcp"
      },
      "robinhood": {
        "type": "remote",
        "url": "https://agent.robinhood.com/mcp/trading"
      },
      "karakeep": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@karakeep/mcp@0.35.0"
        ],
        "environment": {
          "KARAKEEP_API_ADDR": "{env:KARAKEEP_API_ADDR}",
          "KARAKEEP_API_KEY": "{env:KARAKEEP_API_KEY}"
        }
      },
      "lunchmoney": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@akutishevsky/lunchmoney-mcp@4.0.1"
        ],
        "environment": {
          "LUNCHMONEY_API_TOKEN": "{env:LUNCHMONEY_API_TOKEN}"
        }
      },
      "grafana": {
        "type": "local",
        "command": [
          "mcp-grafana",
          "--transport",
          "stdio",
          "--enabled-tools",
          "search,datasource,prometheus,loki,alerting,dashboard,navigation,annotations",
          "--disable-write"
        ],
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      },
      "bigquery": {
        "type": "remote",
        "url": "https://bigquery.googleapis.com/mcp",
        "headers": { "x-goog-user-project": "icco-cloud" },
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/bigquery"
        }
      },
      "cloudstorage": {
        "type": "remote",
        "url": "https://storage.googleapis.com/storage/mcp",
        "headers": { "x-goog-user-project": "icco-cloud" },
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/devstorage.read_only"
        }
      },
      "pubsub": {
        "type": "remote",
        "url": "https://pubsub.googleapis.com/mcp",
        "headers": { "x-goog-user-project": "icco-cloud" },
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/pubsub"
        }
      },
      "cloudbilling": {
        "type": "remote",
        "url": "https://cloudbilling.googleapis.com/mcp",
        "headers": { "x-goog-user-project": "icco-cloud" },
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/cloud-billing.readonly"
        }
      },
      "iam": {
        "type": "remote",
        "url": "https://iam.googleapis.com/mcp",
        "headers": { "x-goog-user-project": "icco-cloud" },
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/iam"
        }
      },
      "cloudmonitoring": {
        "type": "remote",
        "url": "https://monitoring.googleapis.com/mcp",
        "headers": { "x-goog-user-project": "icco-cloud" },
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/monitoring.read"
        }
      },
      "maps": {
        "type": "remote",
        "url": "https://mapstools.googleapis.com/mcp",
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/maps-platform.mapstools"
        }
      },
      "devknowledge": {
        "type": "remote",
        "url": "https://developerknowledge.googleapis.com/mcp",
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/devprofiles.full_control"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "mastodon": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "activitypub-mcp"
        ]
      }
    }
  },
  "skills": [
    "/etc/opencode/skills"
  ],
  "plugins": [
    "opencode-wakatime@1.4.0",
    "superpowers@git+https://github.com/obra/superpowers.git#22f0b463e7a5e579904dd6211a520321035526f7",
    "@slkiser/opencode-quota@6.3.0"
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "google",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "anthropic",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "claude-agent",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "recurse",
      "effect": "allow"
    }
  ]
}
