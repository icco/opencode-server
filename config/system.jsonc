{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "anthropic/claude-opus-5-5",
  "default_agent": "build",
  "providers": {
    "openai": {
      "models": {
        "fast-agent": {
          "name": "Fast Agent",
          "capabilities": { "tools": true },
          "limit": { "context": 1048576, "output": 8192 }
        }
      }
    }
  },
  "shell": "/usr/bin/zsh",
  "worktree": {
    "directory": "/data/workspace/.worktrees"
  },
  "compaction": {
    "buffer": 10000
  },
  "warming": true,
  "agents": {
    "build": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm *.config*", "effect": "ask" },
        { "action": "shell", "resource": "rm *.local*", "effect": "ask" },
        { "action": "shell", "resource": "rm *HOME*", "effect": "ask" },
        { "action": "shell", "resource": "rm *~*", "effect": "ask" },
        { "action": "shell", "resource": "rm */data", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/.*", "effect": "ask" }
      ]
    },
    "general": {
      "model": "openai/fast-agent",
      "permissions": [
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "gmail_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "robinhood_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm *.config*", "effect": "ask" },
        { "action": "shell", "resource": "rm *.local*", "effect": "ask" },
        { "action": "shell", "resource": "rm *HOME*", "effect": "ask" },
        { "action": "shell", "resource": "rm *~*", "effect": "ask" },
        { "action": "shell", "resource": "rm */data", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/.*", "effect": "ask" }
      ]
    },
    "explore": {
      "model": "openai/fast-agent",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "gmail_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "robinhood_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "openai/fast-agent"
    },
    "compaction": {
      "model": "openai/fast-agent"
    }
  },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "limit": { "context": 32768, "output": 8192 }
        },
        "ornith:35b": {
          "name": "Ornith 35B",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "gmail": {
        "type": "remote",
        "url": "https://gmailmcp.googleapis.com/mcp/v1",
        "oauth": {
          "client_id": "{env:GMAIL_MCP_CLIENT_ID}",
          "client_secret": "{env:GMAIL_MCP_CLIENT_SECRET}",
          "redirect_uri": "http://127.0.0.1:19876/callback",
          "scope": "https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose"
        }
      },
      "robinhood": {
        "type": "remote",
        "url": "https://agent.robinhood.com/mcp/trading"
      },
      "karakeep": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@karakeep/mcp@0.34.0"
        ],
        "environment": {
          "KARAKEEP_API_ADDR": "{env:KARAKEEP_API_ADDR}",
          "KARAKEEP_API_KEY": "{env:KARAKEEP_API_KEY}"
        }
      },
      "lunchmoney": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@akutishevsky/lunchmoney-mcp@3.0.0"
        ],
        "environment": {
          "LUNCHMONEY_API_TOKEN": "{env:LUNCHMONEY_API_TOKEN}"
        }
      },
      "grafana": {
        "type": "local",
        "command": [
          "mcp-grafana",
          "--transport",
          "stdio",
          "--enabled-tools",
          "search,datasource,prometheus,loki,alerting,dashboard,navigation,annotations",
          "--disable-write"
        ],
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "skills": [
    "/etc/opencode/skills"
  ],
  "plugins": [
    "opencode-wakatime@1.4.0",
    "superpowers@git+https://github.com/obra/superpowers.git#2ce8aa15d05bd57213e6f746f953aafb7ded7a8b",
    "@slkiser/opencode-quota@5.0.3"
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "google",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "anthropic",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "ollama",
      "effect": "allow"
    }
  ]
}
