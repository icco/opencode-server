{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "anthropic/claude-opus-5-5",
  "default_agent": "build",
  "shell": "/usr/bin/zsh",
  "worktree": {
    "directory": "/data/workspace/.worktrees"
  },
  "compaction": {
    "buffer": 10000
  },
  "agents": {
    "build": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm *.config*", "effect": "ask" },
        { "action": "shell", "resource": "rm *.local*", "effect": "ask" },
        { "action": "shell", "resource": "rm *HOME*", "effect": "ask" },
        { "action": "shell", "resource": "rm *~*", "effect": "ask" },
        { "action": "shell", "resource": "rm */data", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/.*", "effect": "ask" }
      ]
    },
    "general": {
      "permissions": [
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "robinhood_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "rm *.config*", "effect": "ask" },
        { "action": "shell", "resource": "rm *.local*", "effect": "ask" },
        { "action": "shell", "resource": "rm *HOME*", "effect": "ask" },
        { "action": "shell", "resource": "rm *~*", "effect": "ask" },
        { "action": "shell", "resource": "rm */data", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/", "effect": "ask" },
        { "action": "shell", "resource": "rm */data/.*", "effect": "ask" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "robinhood_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "github-copilot/gpt-5.4-mini"
    },
    "compaction": {
      "model": "anthropic/claude-opus-5-5"
    }
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "robinhood": {
        "type": "remote",
        "url": "https://agent.robinhood.com/mcp/trading"
      },
      "karakeep": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@karakeep/mcp@0.34.0"
        ],
        "environment": {
          "KARAKEEP_API_ADDR": "{env:KARAKEEP_API_ADDR}",
          "KARAKEEP_API_KEY": "{env:KARAKEEP_API_KEY}"
        }
      },
      "lunchmoney": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@akutishevsky/lunchmoney-mcp@3.0.0"
        ],
        "environment": {
          "LUNCHMONEY_API_TOKEN": "{env:LUNCHMONEY_API_TOKEN}"
        }
      },
      "grafana": {
        "type": "local",
        "command": [
          "mcp-grafana",
          "--transport",
          "stdio",
          "--enabled-tools",
          "search,datasource,prometheus,loki,alerting,dashboard,navigation,annotations",
          "--disable-write"
        ],
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "skills": [
    "/etc/opencode/skills"
  ],
  "plugins": [
    "opencode-gemini-auth@2.0.1",
    "opencode-wakatime@1.4.0",
    "superpowers@git+https://github.com/obra/superpowers.git#2ce8aa15d05bd57213e6f746f953aafb7ded7a8b",
    "@slkiser/opencode-quota@5.0.3",
    {
      "package": "opencode-runtime-fallback@0.3.0",
      "options": {
        "fallback_models": [
          "openai/gpt-6-astra",
          "google/gemini-4-argon",
          "github-copilot/gpt-6-astra"
        ],
        "retryable_error_patterns": [
          "usage limits",
          "exceeded your current quota",
          "credit_balance_exhausted",
          "no credits remaining",
          "model\\b.*\\bnot (?:be )?found",
          "model_not_found"
        ],
        "cooldown_seconds": 3600,
        "timeout_seconds": 120
      }
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "google",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "github-copilot",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "anthropic",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    }
  ]
}
