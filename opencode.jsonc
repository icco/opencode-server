{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "github-copilot/gpt-6-astra",
  "default_agent": "build",
  "worktree": {
    "directory": "/data/workspace/.worktrees"
  },
  "compaction": {
    "buffer": 10000
  },
  "agents": {
    "build": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" }
      ]
    },
    "general": {
      "permissions": [
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "grafana_*", "resource": "*", "effect": "deny" },
        { "action": "lunchmoney_*", "resource": "*", "effect": "deny" },
        { "action": "karakeep_*", "resource": "*", "effect": "deny" },
        { "action": "notion_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "github-copilot/gpt-5.4-mini"
    },
    "compaction": {
      "model": "github-copilot/gpt-6-astra"
    }
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "robinhood": {
        "type": "remote",
        "url": "https://agent.robinhood.com/mcp/trading"
      },
      "karakeep": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@karakeep/mcp@0.33.1"
        ],
        "environment": {
          "KARAKEEP_API_ADDR": "{env:KARAKEEP_API_ADDR}",
          "KARAKEEP_API_KEY": "{env:KARAKEEP_API_KEY}"
        }
      },
      "lunchmoney": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@akutishevsky/lunchmoney-mcp@3.0.0"
        ],
        "environment": {
          "LUNCHMONEY_API_TOKEN": "{env:LUNCHMONEY_API_TOKEN}"
        }
      },
      "grafana": {
        "type": "local",
        "command": [
          "mcp-grafana",
          "--transport",
          "stdio",
          "--enabled-tools",
          "search,datasource,prometheus,loki,alerting,dashboard,navigation,annotations",
          "--disable-write"
        ],
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "skills": [
    "/etc/opencode/skills"
  ],
  "plugins": [
    "opencode-gemini-auth@2.0.1",
    "opencode-wakatime@1.4.0",
    "superpowers@git+https://github.com/obra/superpowers.git#bb92a77741419a4ab5f06e711a283343f1ada0c3",
    "@slkiser/opencode-quota@5.0.2"
  ],
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "google",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "github-copilot",
        "effect": "allow"
      }
    ]
  }
}
