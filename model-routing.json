{
  "agents": ["auto"],
  "quotaCacheSeconds": 60,
  "quotaReserveFraction": 0.1,
  "unknownQuota": "allow",
  "cooldownSeconds": 300,
  "contextReserveTokens": 16000,
  "rules": [
    {
      "name": "design-and-debugging",
      "pattern": "\\b(architect(?:ure)?|design|debug|race condition|deadlock|security|review|migration)\\b",
      "models": [
        "github-copilot/claude-opus-5.5",
        "github-copilot/gpt-6-astra",
        "github-copilot/claude-opus-5",
        "google/gemini-3.1-pro-preview"
      ]
    },
    {
      "name": "simple-work",
      "firstTurnOnly": true,
      "maxPromptCharacters": 500,
      "pattern": "^(?:please )?(?:fix (?:a |the )?typo|format (?:this|the)|rename \\S+ to \\S+|summarize|explain (?:this|the))\\b",
      "models": [
        "google/gemini-3.8-flash",
        "github-copilot/claude-sonnet-5",
        "github-copilot/gpt-5.4-mini"
      ]
    }
  ],
  "defaultModels": [
    "github-copilot/gpt-6-astra",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5",
    "google/gemini-3.1-pro-preview",
    "google/gemini-3.8-flash"
  ]
}
