OPENCODE_SERVER_PASSWORD=
# Alternatively set OPENCODE_SERVER_PASSWORD_FILE to a mounted secret's container path.
OPENCODE_SERVER_PASSWORD_FILE=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_PUBLIC_URL=http://localhost:4096
# For HTTPS hosting, list only the TLS proxy's source IPs/CIDRs, not all private networks.
OPENCODE_TRUSTED_PROXIES=
# Optional GitHub token for gh and HTTPS Git operations; otherwise use gh auth login.
GH_TOKEN=
