OPENCODE_SERVER_PASSWORD=
# Optional GitHub token for gh and HTTPS Git operations; otherwise use gh auth login.
GH_TOKEN=
# Optional Gemini API key, or project ID for organization-backed Code Assist OAuth.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENCODE_GEMINI_PROJECT_ID=
# Lunch Money token from https://my.lunchmoney.app/developers.
LUNCHMONEY_API_TOKEN=
# Grafana MCP also queries the instance's Loki and Prometheus datasources.
# Include the subpath if Grafana is served under one, e.g. https://host/grafana/.
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
